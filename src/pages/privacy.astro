---
import Base from '../layouts/Base.astro';
import Text from '../components/story/Text.astro';
import { consent, privacy } from '../content/privacy';
import { links } from '../data/links';

const canonicalUrl = new URL(links.privacy, links.siteUrl).href;
const { title, description, who, analytics, storage, hosting, rights, external, questions } = privacy;
const sections = [['who', who.heading], ['privacy-choice-h', privacy.choiceHeading], ['analytics', analytics.heading], ['storage', storage.heading], ['hosting', hosting.heading], ['rights', rights.heading], ['external', external.heading], ['questions', questions.heading]];
---
<Base {title} {description} {canonicalUrl} jsonLd={false}>
  <main id="main" class="privacy section">
    <div class="container document-layout">
      <nav class="document-toc" aria-label={privacy.onThisPage}>
        <p>{privacy.onThisPage}</p>
        <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </nav>
      <div class="document-content">
        <article class="document-body">
      <h1>{title}</h1>
        <aside class="document-summary" aria-labelledby="summary-heading">
          <h2 id="summary-heading">{privacy.summaryHeading}</h2>
          <ul>{privacy.summary.map(item => <li>{item}</li>)}</ul>
        </aside>
        <details class="document-toc-mobile">
          <summary>{privacy.onThisPage}</summary>
          <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </details>
      <p class="lead">{description}</p>
      <p class="note">{privacy.reviewed} <time datetime={privacy.reviewDate}>{privacy.reviewDate}</time></p>

      <h2 id="who">{who.heading}</h2>
      <p>{who.text}</p>

      <section class="privacy-choice" aria-labelledby="privacy-choice-h">
        <h2 id="privacy-choice-h">{privacy.choiceHeading}</h2>
        <p data-analytics-status aria-live="polite">{consent.status.undecided}</p>
        <button class="button" type="button" data-analytics-settings aria-haspopup="dialog" hidden>{consent.settings}</button>
        <noscript><p>{privacy.noScript}</p></noscript>
      </section>

      <h2 id="analytics" tabindex="-1">{analytics.heading}</h2>
      {analytics.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      <ul class="document-links">{analytics.google.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>

      <h2 id="storage">{storage.heading}</h2>
      {storage.paragraphs.map(paragraph => <p><Text text={paragraph} /></p>)}

      <h2 id="hosting">{hosting.heading}</h2>
      <p>{hosting.text}</p>

      <h2 id="rights">{rights.heading}</h2>
      <p>{rights.choices}</p>
      <p>{rights.before}<a href={questions.email.href}>{questions.email.label}</a>{rights.after}</p>

      <h2 id="external">{external.heading}</h2>
      <p>{external.text}</p>

      <h2 id="questions" class="document-questions">{questions.heading}</h2>
      <p>{questions.before}<a href={questions.issues.href}>{questions.issues.label}</a>{questions.between}<a href={questions.email.href}>{questions.email.label}</a>{questions.after}</p>
        </article>
      </div>
    </div>
  </main>
  <script>import "../scripts/document-toc";</script>
</Base>
