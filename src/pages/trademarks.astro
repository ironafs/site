---
import Base from '../layouts/Base.astro';
import { trademarks } from '../content/trademarks';
import { links } from '../data/links';

const canonicalUrl = new URL(links.trademarks, links.siteUrl).href;
const { title, intro, claim, rights, references, questions } = trademarks;
const { readme } = references;
const sections = [['claim', claim.heading], ['rights', rights.heading], ['references', references.heading], ['questions', questions.heading]];
---
<Base {title} {canonicalUrl} jsonLd={false}>
  <main id="main" class="trademarks section">
    <div class="container document-layout">
      <nav class="document-toc" aria-label={trademarks.onThisPage}>
        <p>{trademarks.onThisPage}</p>
        <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </nav>
      <div class="document-content">
        <p class="document-source">{trademarks.source}</p>
        <article class="document-body" data-canonical-policy>
      <h1>{title}</h1>
        <aside class="document-summary" aria-labelledby="summary-heading">
          <h2 id="summary-heading">{trademarks.summaryHeading}</h2>
          <ul>{trademarks.summary.map(item => <li>{item}</li>)}</ul>
        </aside>
        <details class="document-toc-mobile">
          <summary>{trademarks.onThisPage}</summary>
          <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </details>
      <p>{intro}</p>

      <h2 id="claim">{claim.heading}</h2>
      {claim.paragraphs.map(({ before, after }) => <p>{before}<strong>{claim.name}</strong>{after}</p>)}

      <h2 id="rights">{rights.heading}</h2>
      <p>{rights.before}<a href={rights.href}>{rights.label}</a>{rights.after}</p>

      <h2 id="references">{references.heading}</h2>
      <p>{references.intro}</p>
      <ul>
        {references.examples.map(({ lead, text }) => <li><strong>{lead}</strong>{text}</li>)}
      </ul>
      <p>{readme.before}<a href={readme.href}>{readme.label}</a>{readme.after}</p>

      <h2 id="questions" class="document-questions">{questions.heading}</h2>
      <p>{questions.before}<a href={questions.href}>{questions.label}</a>{questions.after}</p>
        </article>
      </div>
    </div>
  </main>
  <script>import "../scripts/document-toc";</script>
</Base>
