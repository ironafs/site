---
// The cost of shipping kernel code (#cost): four stacked cards, Windows, macOS, Linux and IronAFS,
// each its text and its picture. Base (phones, reduced motion, no scroll-driven animation, html.static): the cards in
// normal flow, every picture at its final state. Enhancement (cost.css): the cards are sticky in one stack; each
// tilts up into place, pins and plays its picture, then sinks back as the next slides over it. The beats of each
// picture carry data-step (and data-span for a longer one); src/scripts/story/stack.ts turns them into scroll
// ranges measured from the layout.
import Section from './Section.astro';
import Art from './Art.astro';
import PhoneBeat from './PhoneBeat.astro';
import '../../styles/story/cost.css';
import drops from '../../assets/story/drops.png';
import { story } from '../../content/story';

const { cost } = story;
const { windows, macos, linux, ironafs } = cost;
const { dialog } = macos;
---
<Section id="cost" eyebrow={cost.eyebrow} heading={cost.heading}>
  <div class="stack" data-stack>
    <article class="scard" aria-labelledby="cost-windows">
      <div class="copy">
        <p class="os">{windows.os}</p>
        <h3 id="cost-windows">{windows.heading}</h3>
        <p class="lede">{windows.lede}</p>
        <p class="cost-context">{windows.context}</p>
        <div class="foot">{windows.sources.map(link => <a href={link.href}>{link.label}</a>)}</div>
      </div>
      <PhoneBeat><div class="vis">
        <p class="cost-panel-title">{windows.signing}</p>
        <ol class="pipe" role="list">
          {windows.steps.map((step, i) => <li class="on" data-step={i}><b aria-hidden="true">{i + 1}</b> {step}</li>)}
        </ol>
        <p class="cost-panel-note on" data-step={windows.steps.length}>
          <strong>{windows.testing.title}</strong> {windows.testing.before}<a href={windows.testing.link.href}>{windows.testing.link.label}</a>{windows.testing.after}
        </p>
      </div></PhoneBeat>
    </article>

    <article class="scard" aria-labelledby="cost-macos">
      <div class="copy">
        <p class="os">{macos.os} <span>{macos.platform}</span></p>
        <h3 id="cost-macos">{macos.heading}</h3>
        <p class="lede">{macos.lede}</p>
        <p class="cost-context">{macos.context}</p>
        <div class="foot">{macos.sources.map(link => <a href={link.href}>{link.label}</a>)}</div>
      </div>
      <PhoneBeat><div class="vis">
        <p class="cost-panel-title">{dialog.title}<span>{dialog.label}</span></p>
        <div class="mac">
          <p class="opt on" data-step="0"><span class="r" aria-hidden="true"><i class="dot doff" data-step="1"></i></span>{dialog.full}</p>
          <p class="opt on" data-step="1"><span class="r" aria-hidden="true"><i class="dot don" data-step="1"></i></span>{dialog.reduced}</p>
          <p class="opt sub on" data-step="2"><span class="c" aria-hidden="true" data-step="2">✓</span>{dialog.allow}</p>
        </div>
        <p class="cost-panel-note">{macos.steps.map((step, i) => <>{i > 0 && <span aria-hidden="true"> → </span>}{i === 0 ? <strong>{step}</strong> : step}</>)}</p>
      </div></PhoneBeat>
    </article>

    <article class="scard" aria-labelledby="cost-linux">
      <div class="copy">
        <p class="os">{linux.os}</p>
        <h3 id="cost-linux">{linux.heading}</h3>
        <p class="lede">{linux.lede}</p>
        <p class="cost-context">{linux.context}</p>
        <div class="foot">{linux.sources.map(link => <a href={link.href}>{link.label}</a>)}</div>
      </div>
      <PhoneBeat><div class="vis" data-illustrative="debian">
        <p class="cost-panel-title">{linux.workflow.title}<span>{linux.workflow.label}</span></p>
        <ol class="cost-terminal" role="list">
          {linux.workflow.lines.map((line, i) => (
            <li class:list={['on', { 'cost-panel-note': 'note' in line }]} data-step={i}>
              {'note' in line ? <><strong>{line.text}</strong> {linux.workflow.failure}</> : <><b aria-hidden="true">›</b>{line.text}</>}
            </li>
          ))}
        </ol>
      </div></PhoneBeat>
    </article>

    <article class="scard iron" aria-labelledby="cost-ironafs">
      <div class="iron-art" aria-hidden="true">
        <Art src={drops} widths={[640, 1024, 1360]} sizes="(min-width: 761px) 84vw, 100vw" />
      </div>
      <div class="copy iron-copy">
        <p class="os">{ironafs.os}</p>
        <h3 id="cost-ironafs">{ironafs.heading}</h3>
        <p class="lede">{ironafs.lede}</p>
        <div class="foot">{ironafs.sources.map(link => <a href={link.href}>{link.label}</a>)}</div>
        <PhoneBeat><div class="afs">
          <p class="bigcmd"><span class="p">{ironafs.prompt} </span><span class="typed" data-step="0" data-span="3">{ironafs.command}</span><span class="cur" aria-hidden="true"></span></p>
          <p class="bigout">
            <span class="on ok" data-step="3">{ironafs.output.ok}</span>
            <span class="on design" data-step="4">{ironafs.output.design}</span>
          </p>
        </div></PhoneBeat>
      </div>
    </article>
  </div>
</Section>

<script>
  import { initStacks } from '../../scripts/story/stack';
  initStacks();
</script>
