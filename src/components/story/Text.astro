---
// A story string with inline code: spans between backticks become <code> (story.ts codeSpans). Astro escapes both.
import { codeSpans } from '../../lib/text';

interface Props { text: string }
const { text } = Astro.props;
---
{codeSpans(text).map(part => part.code ? <code>{part.text}</code> : part.text)}
