---
import Section from './Section.astro';
import Text from './Text.astro';
import { rust } from '../../content/rust';
import '../../styles/story/rust.css';

const { heading, fixture, ownership, evidence, share, density, engineering } = rust;
---
<Section id="rust" labelledby="rust-h">
  <div data-rust-track="project">
    <div class="rust-project">
      <div class="rust-intro">
        <h2 id="rust-h" tabindex="-1">{heading.before}<span class="heading-accent">{heading.accent}</span>{heading.after}<span class="heading-tail">{heading.tail}</span></h2>
        <p>{rust.rationale}</p>
        <p><strong>{rust.safety.lead}</strong> {rust.safety.rest}</p>
        <p>{rust.example}</p>
      </div>
      <div data-rust-track="fixture">
        <figure class="xdr-fixture" aria-labelledby="xdr-title">
          <figcaption>
            <p class="xdr-label">{fixture.label}</p>
            <h3 id="xdr-title">{fixture.heading}</h3>
          </figcaption>
          <div class="xdr-readout">
            <div><strong>{fixture.declared.value}</strong><span>{fixture.declared.label}</span></div>
            <div data-xdr-reveal="2"><strong>{fixture.available.value}</strong><span>{fixture.available.label}</span></div>
          </div>
          <div class="xdr-wire">
            <div class="xdr-group">
              <span>{fixture.lengthPrefix.label}</span>
              <code>{fixture.lengthPrefix.start} <b>{fixture.lengthPrefix.end}</b></code>
            </div>
            <div class="xdr-group">
              <span>{fixture.field.label}</span>
              <div class="xdr-bytes" role="img" aria-label={fixture.field.description}>
                {fixture.field.bytes.map((byte, index) => <code data-xdr-reveal={index + 1} aria-hidden="true">{byte}</code>)}
                {Array.from({ length: fixture.field.missing }, () => <span data-xdr-reveal="3" aria-hidden="true"></span>)}
              </div>
            </div>
          </div>
          <div class="xdr-result">
            <p data-xdr-reveal="4"><Text text={fixture.result} /></p>
            <div class="rust-links">
              {fixture.sources.map(source => <a class="source" href={source.href}>{source.label} <span aria-hidden="true">↗</span></a>)}
            </div>
          </div>
        </figure>
      </div>
      <div class="rust-notes">
        <details class="rust-disclosure">
          <summary>{ownership.summary}</summary>
          <p>{ownership.text}</p>
          <div class="rust-links">
            {ownership.sources.map(source => <a class="source" href={source.href}>{source.label} <span aria-hidden="true">↗</span></a>)}
          </div>
        </details>
        <p>{rust.platformDetail}</p>
        <p class="rust-name">{rust.name}</p>
      </div>
    </div>
  </div>

  <section class="android-evidence" aria-labelledby="android-heading">
    <div class="android-intro">
      <h3 id="android-heading">{evidence.heading}</h3>
      <p>{evidence.lede}</p>
    </div>
    <div data-rust-track="android">
      <div class="android-panels">
        <div data-rust-track="share">
          <article class="android-card" data-stat={share.id} aria-labelledby="android-share-title">
            <p class="android-label">{evidence.label}</p>
            <h4 id="android-share-title">{share.heading}</h4>
            <p class="android-unit">{share.unit}</p>
            <div class="chart-plot">
              <div class="chart-guides" aria-hidden="true">
                {share.ticks.map(tick => <span>{tick}</span>)}
              </div>
              <ol class="chart-bars" role="list" aria-label={share.chartLabel}>
                {share.points.map(point => (
                  <li class={`chart-column chart-h${point.height}`}>
                    <span class="sr-only">{point.year}, {point.upperBound ?? point.value}</span>
                    <div class="chart-bar" aria-hidden="true">
                      <span class="chart-point"><strong>{point.value}</strong><span>{point.year}</span></span>
                      <span class="chart-fill"></span>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <p class="chart-bound"><span aria-hidden="true"></span>{share.bound}</p>
            <div class="android-sources">
              <span>{share.sourceLabel}</span>
              {share.sources.map(source => <a class="source" href={source.href} aria-label={source.name}>{source.label} <span aria-hidden="true">↗</span></a>)}
            </div>
          </article>
        </div>
        <div data-rust-track="density">
          <p class="android-transition">{density.transition}</p>
          <article class="android-card" data-stat={density.id} aria-labelledby="android-density-title">
            <p class="android-label">{evidence.label}</p>
            <h4 id="android-density-title">{density.heading}</h4>
            <p class="android-unit">{density.unit}</p>
            <figure class="density-scale" data-illustrative="dots" aria-label={density.illustration}>
              <div class="density-side">
                <span>{density.cLabel}</span><strong>{density.cValue}</strong>
                <div class="density-field" aria-hidden="true"></div>
              </div>
              <div class="density-side">
                <span>{density.rustLabel}</span><strong>{density.rustValue}</strong>
                <div class="density-dot" aria-hidden="true"><i></i></div>
              </div>
            </figure>
            <p class="density-caveat"><strong>{density.limit}</strong> {density.methodology}</p>
            <div class="android-sources">
              <a class="source" href={density.source.href}>{density.source.label} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        </div>
      </div>
    </div>
    <details class="rust-disclosure" id="android-engineering">
      <summary>{engineering.summary}</summary>
      <p>{engineering.text}</p>
      <a class="source" href={engineering.source.href}>{engineering.source.label} <span aria-hidden="true">↗</span></a>
    </details>
  </section>
</Section>

<script>
  import { initRustMotion } from '../../scripts/story/rust-motion';
  initRustMotion();
</script>
