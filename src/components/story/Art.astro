---
// Story art: AVIF and WebP at the sizes it is shown (WebP, not the PNG master, as the fallback),
// lazy, decorative (alt=""). `afterLoad` holds the picture in a <template> until the page's `load` event, for art
// close enough to the fold that the browser's lazy loading would fetch it with the page (after-load.ts); without
// JavaScript the <noscript> copy is the picture.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; widths?: number[]; sizes?: string; afterLoad?: boolean }
const { src, widths = [640, 1280, 1920], sizes = '100vw', afterLoad = false } = Astro.props;
---
{afterLoad ? (
  <>
    <template class="art-held"><Picture src={src} formats={['avif', 'webp']} widths={widths} sizes={sizes} fallbackFormat="webp" alt="" loading="lazy" decoding="async" /></template>
    <noscript><Picture src={src} formats={['avif', 'webp']} widths={widths} sizes={sizes} fallbackFormat="webp" alt="" loading="lazy" decoding="async" /></noscript>
  </>
) : (
  <Picture src={src} formats={['avif', 'webp']} widths={widths} sizes={sizes} fallbackFormat="webp" alt="" loading="lazy" decoding="async" />
)}

<script>
  import { revealHeldArt } from '../../scripts/story/after-load';
  revealHeldArt();
</script>
