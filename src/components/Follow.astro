---
import { follow } from '../content/site';
---
<section id="follow" class="section" aria-labelledby="follow-h">
  <div class="container">
    <div class="follow-layout">
      <div>
        <p class="eyebrow"><span class="slash" aria-hidden="true">/</span>{follow.eyebrow}</p>
        <h2 id="follow-h" tabindex="-1">{follow.heading}</h2>
        <p class="follow-lead">{follow.intro} <strong>{follow.watch}</strong> {follow.watchDetail}</p>
        <a class="button follow-primary" href={follow.primary.href}>{follow.primary.label} <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="follow-resources" role="list">
        {follow.resources.map(resource => (
          <li>
            <a href={resource.href}>
              <span class="follow-resource-title">{resource.label}</span>
              <span class="follow-resource-description">{resource.description}</span>
              <span class="follow-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
