{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npx playwright test:*)",
      "Bash(node tools/ci-local.mjs:*)",
      "Bash(node --test:*)",
      "Bash(reuse lint:*)"
    ],
    "deny": [
      "Bash(gh auth token:*)",
      "Bash(gh auth status --show-token:*)",
      "Bash(gh auth status -t:*)",
      "Bash(gh auth git-credential:*)",
      "Bash(git credential:*)",
      "Bash(git config --list:*)",
      "Bash(git config -l:*)",
      "Bash(git config list:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(set)",
      "Bash(export -p:*)",
      "Bash(declare -p:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security find-internet-password:*)",
      "Bash(security dump-keychain:*)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Bash(gh auth status -h:*)",
      "Bash(gh auth status --hostname:*)",
      "Bash(git config --global --list:*)",
      "Bash(git config --global -l:*)",
      "Bash(git config --system --list:*)",
      "Bash(git config --system -l:*)",
      "Bash(git config --local --list:*)",
      "Bash(git config --show-origin --list:*)",
      "Bash(git config --show-origin -l:*)",
      "Bash(git --no-pager config:*)",
      "Bash(git credential-osxkeychain:*)",
      "Bash(git credential-store:*)",
      "Bash(git-credential-osxkeychain:*)",
      "Bash(git-credential-store:*)",
      "Bash(export)",
      "Bash(typeset)",
      "Bash(typeset -p:*)",
      "Bash(declare)",
      "Bash(declare -x:*)",
      "Bash(/usr/bin/env)",
      "Bash(/usr/bin/printenv:*)",
      "Bash(env -0:*)",
      "Read(~/.zshenv)",
      "Read(~/.codex/auth.json)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git config --get-regexp:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gemini/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.keytab)",
      "Read(**/KeyFile*)",
      "Read(//tmp/krb5cc_*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.npmrc)",
      "Read(**/.npmrc)"
    ]
  }
}
